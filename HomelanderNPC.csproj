<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HomelanderNPC</AssemblyName>
    <RootNamespace>HomelanderNPC</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader 0.6.5 matches the Quest setup you have been testing. -->
    <PackageReference Include="LavaGang.MelonLoader" Version="0.6.5" />
    <!-- BONELAB is a Unity game; this package supplies the UnityEngine core API at build time. -->
    <PackageReference Include="UnityEngine.CoreModule" Version="2020.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
</Project>
